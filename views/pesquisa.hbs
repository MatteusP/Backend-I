<h1 class="mb-3">Pesquisa de Oficinas</h1>

<form method="POST" action="/pesquisa">
  <div class="mb-3">
    <label for="termo" class="form-label">Título da oficina</label>
    <input type="text" class="form-control" id="termo" name="termo" value="{{termo}}" required />
  </div>

  <button type="submit" class="btn btn-primary">Pesquisar</button>
</form>

{{#if pesquisou}}
  {{#if resultados.length}}
    <ul class="mt-3">
      {{#each resultados}}
        <li><a href="/oficinas/consulta/{{id}}">{{titulo}}</a></li>
      {{/each}}
    </ul>
  {{else}}
    <p class="mt-3">Nenhuma oficina encontrada.</p>
  {{/if}}
{{else}}
  <p class="mt-3">Digite um termo para pesquisar pelo título da oficina.</p>
{{/if}}
